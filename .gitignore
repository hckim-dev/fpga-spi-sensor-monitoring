# Vivado project-local caches, generated products, and hardware sessions.
# Keep .xpr and .srcs: these contain the project settings and input files.
/master/spi_sensor_master.cache/
/master/spi_sensor_master.hw/
/master/spi_sensor_master.ip_user_files/
/master/spi_sensor_master.sim/
/master/spi_sensor_master.runs/
/master/spi_sensor_master.gen/
/master/.Xil/
/slave/spi_sensor_slave.cache/
/slave/spi_sensor_slave.hw/
/slave/spi_sensor_slave.ip_user_files/
/slave/spi_sensor_slave.sim/
/slave/spi_sensor_slave.runs/
/slave/spi_sensor_slave.gen/
/slave/.Xil/
/.Xil/

# Vivado session logs and journals in the repository and project roots.
/vivado*.log
/vivado*.jou
/vivado*.str
/master/vivado*.log
/master/vivado*.jou
/master/vivado*.str
/slave/vivado*.log
/slave/vivado*.jou
/slave/vivado*.str

# Qt shadow builds and Qt Creator's local kit settings.
/desktop/build*/
/desktop/.qtc_clangd/
/desktop/.qtcreator/
/desktop/*.pro.user*
/desktop/tests/*.pro.user*

# Sensor Desk's default session exports.
/sensor_*.csv

# Python caches; keep verification scripts and test inputs.
__pycache__/
*.py[cod]

# Windows Explorer metadata.
Thumbs.db
Desktop.ini

# Local agent instructions.
/AGENTS.md
